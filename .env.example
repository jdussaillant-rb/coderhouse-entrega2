# Proveedor del LLM: openai | anthropic
LLM_PROVIDER=openai

# Claves de API (solo hace falta la del proveedor elegido)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelos (opcional)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-5-5

# Parámetros del modelo (opcional)
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30
